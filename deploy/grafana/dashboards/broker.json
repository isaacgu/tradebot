{
  "uid": "tradebot-broker",
  "title": "Tradebot · Broker & Positions",
  "description": "Read-only actual terminal account, positions, pending orders and bounded quotes; no bot attribution or trading controls.",
  "tags": [
    "tradebot",
    "broker",
    "read-only"
  ],
  "timezone": "Africa/Johannesburg",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "links": [
    {
      "title": "Trading System Overview",
      "type": "link",
      "url": "/d/tradebot-system",
      "targetBlank": false
    },
    {
      "title": "Data & Quality",
      "type": "link",
      "url": "/d/tradebot-data-quality",
      "targetBlank": false
    },
    {
      "title": "Acquisition",
      "type": "link",
      "url": "/d/tradebot-acquisition",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Broker & Positions · read only",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "All terminal trades are shown, including manual/external activity — **not certified bot trades**. View only; no trading controls. Check freshness before using retained values."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "Freshness",
      "type": "stat",
      "description": "A failed read, no snapshot or age over 15 seconds marks the retained snapshot stale.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(max(tradebot_broker_snapshot_stale) + (time() - max(tradebot_broker_last_success_timestamp_seconds) > bool 15), 1)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "tradebot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No confirmed snapshot",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Fresh",
                  "color": "green"
                },
                "1": {
                  "text": "Stale / unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Age",
      "type": "stat",
      "description": "Age of the last fully successful account/position/order snapshot.",
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (tradebot_broker_last_success_timestamp_seconds > 0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "tradebot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
