    {
      "id": 14,
      "title": "Open positions · includes manual and external",
      "type": "table",
      "description": "Exact ticket, symbol, side, volume, entry/current prices, protection levels and broker P&L. This is a read-only last-confirmed snapshot.",
      "gridPos": {
        "x": 0,
        "y": 13,
