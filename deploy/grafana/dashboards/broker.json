            "uid": "tradebot-prometheus"
          }
        },
        {
          "refId": "H",
          "expr": "tradebot_broker_position_open_timestamp_seconds * 1000",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Opened",
          "datasource": {
            "type": "prometheus",
            "uid": "tradebot-prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "__name__"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "origin": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "ticket": 0,
              "symbol": 1,
              "side": 2,
              "origin": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8,
              "Value #F": 9,
              "Value #G": 10,
              "Value #H": 11
            },
            "renameByName": {
              "ticket": "Ticket",
              "symbol": "Symbol",
              "side": "Side / type",
              "origin": "Attribution",
              "Value #A": "Lots",
              "Value #B": "Open",
              "Value #C": "Current",
              "Value #D": "SL",
              "Value #E": "TP",
              "Value #F": "Profit",
              "Value #G": "Swap",
              "Value #H": "Opened"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 5,
          "noValue": "—",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lots"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Profit"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Swap"
            },
