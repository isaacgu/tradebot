{
  "uid": "tradebot-research",
  "title": "Tradebot · Engineering Replay",
  "description": "Verified summary of a completed engineering decision replay; never live calls, trades or performance.",
  "tags": [
    "tradebot",
    "research",
    "engineering-evidence"
  ],
  "timezone": "Africa/Johannesburg",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "links": [
    {
      "title": "Trading System Overview",
      "type": "link",
      "url": "/d/tradebot-system",
      "targetBlank": false
    },
    {
      "title": "Data & Quality",
      "type": "link",
      "url": "/d/tradebot-data-quality",
      "targetBlank": false
    },
    {
      "title": "Acquisition Progress",
      "type": "link",
      "url": "/d/tradebot-acquisition",
      "targetBlank": false
    },
    {
      "title": "Broker & Trades",
      "type": "link",
      "url": "/d/tradebot-broker",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Engineering Replay",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Read-only, completed replay: `latest.json` selects a bounded, SHA-256-verified report. No replay or detailed trace is opened here.\n\n**SYNTHETIC** = invented bars; **CLEAN SNAPSHOT** = selected immutable corpus. Neither is data acceptance, backtest validation or strategy approval.\n\n**Engineering only:** no execution, orders, fills, costs or P&L; not live calls or trades. Forecasts are uncalibrated. Missing/rejected evidence = **UNKNOWN**."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "Replay evidence",
      "type": "stat",
      "description": "The mutable pointer, immutable report hash, schema, content-addressed run ID, frozen/current SPEC identity and engineering-only safety fields must all verify.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Verified · engineering only",
                  "color": "blue"
                },
                "2": {
                  "text": "Rejected · UNKNOWN",
                  "color": "red"
                },
                "3": {
                  "text": "Missing · UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "noValue": "Exporter unavailable · UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tradebot_research_artifact_state{state=\"verified\"}) + 2 * sum(tradebot_research_artifact_state{state=\"invalid\"}) + 3 * sum(tradebot_research_artifact_state{state=\"missing\"})",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Replay source",
      "type": "stat",
      "description": "Only synthetic fixtures or an explicitly selected immutable clean snapshot are supported; both remain engineering-only evidence.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SYNTHETIC · engineering only",
                  "color": "purple"
                },
                "2": {
                  "text": "CLEAN SNAPSHOT · engineering only",
                  "color": "blue"
                }
              }
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tradebot_research_source_kind{kind=\"synthetic\"}) + 2 * sum(tradebot_research_source_kind{kind=\"immutable_clean_snapshot\"})",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bars replayed",
      "type": "stat",
      "description": "Input bars with a recorded engineering decision. This is volume, not P&L, trades or usable-history acceptance.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed-color",
            "fixedColor": "blue"
          },
          "mappings": [],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_research_bars_processed",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Engineering decisions by status",
      "type": "bargauge",
      "description": "Counts reconcile exactly to bars replayed. Warmup, suppression, abstention and uncalibrated forecast are research decisions—not orders or calls.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_research_decisions",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    }
  ]
}
