    {
      "id": 1,
      "title": "Trading System Overview",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No observation"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "## Tradebot · System overview\nA research-to-live trading platform, built through evidence gates. **Data → Backtesting → Strategies & Portfolio → Risk & Execution → Paper Operations**.\n\nThis page shows what exists across the whole bot. The current acquisition run is one part of the Data & Quality section. A component's source files do not establish readiness; gate approval is displayed only when recorded evidence matches the specification."
      },
      "targets": []
    },
    {
      "id": 21,
      "title": "Reference report integrity",
      "type": "stat",
      "description": "Selected saved reference-month diagnostic. Checksum integrity is not data acceptance or approval.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "gray"
                },
                "1": {
                  "text": "Incomplete · no checksum",
                  "color": "orange"
                },
                "2": {
                  "text": "Report verified",
                  "color": "blue"
                },
                "3": {
                  "text": "Invalid report",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_reference_report_state",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ]
    },
    {
      "id": 22,
      "title": "Reference acceptance",
      "type": "stat",
      "description": "The report's overall result. Incomplete approval can coexist with a failed numerical threshold. Passing a calculation cannot approve Gate 1 or training.",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Incomplete / indeterminate",
                  "color": "orange"
                },
                "1": {
                  "text": "Failed",
                  "color": "red"
                },
                "2": {
                  "text": "Calculation passed only",
                  "color": "blue"
                }
              }
            }
          ],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_reference_acceptance_state",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ]
    },
    {
      "id": 23,
      "title": "Flagged minutes · must be <0.1%",
      "type": "stat",
      "description": "Exact union numerator / expected liquid-minute denominator shown under the percentage. Scope and selected path appear in Data & Quality. Missing evidence remains unavailable.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_reference_flagged_fraction",
          "range": false,
          "editorMode": "code",
          "instant": true,
          "legendFormat": "{{numerator}} / {{denominator}}"
        }
      ]
    },
