    {
      "id": 1,
      "title": "Data & Quality evidence",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "noValue": "No evidence",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "## Data & Quality · Evidence\nThe reference-month diagnostic below is separate from the retained 30-day reproducibility report further down. **A failed numerical threshold and incomplete approval are different results.**\n\nThis observer has no fitting producer or training control. Saved reports keep their original dates and scope; matching current code does not make source data current. Missing or rejected evidence stays unavailable."
      },
      "targets": []
    },
    {
      "id": 19,
      "title": "Reference report integrity",
      "type": "stat",
      "description": "Selected saved reference-month diagnostic. Checksum integrity is not data acceptance or approval.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "gray"
                },
                "1": {
                  "text": "Incomplete · no checksum",
                  "color": "orange"
                },
                "2": {
                  "text": "Report verified",
                  "color": "blue"
                },
                "3": {
                  "text": "Invalid report",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradebot_reference_report_state",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ]
    },
